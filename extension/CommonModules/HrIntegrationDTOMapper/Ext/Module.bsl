// Декларативный маппинг плоских DTO. Правила и преобразователь передаются вызывающим кодом.

Функция НовоеПравило(
	ИмяПоляИсточника,
	ИмяПоляПриемника,
	Обязательное = Ложь,
	ЗначениеПоУмолчанию = Неопределено,
	КодПреобразования = "") Экспорт

	Если ПустаяСтрока(ИмяПоляИсточника) Или ПустаяСтрока(ИмяПоляПриемника) Тогда
		ВызватьИсключение "Имена полей правила не могут быть пустыми.";
	КонецЕсли;

	Возврат Новый Структура(
		"ИмяПоляИсточника,ИмяПоляПриемника,Обязательное,ЗначениеПоУмолчанию,КодПреобразования",
		ИмяПоляИсточника,
		ИмяПоляПриемника,
		Обязательное,
		ЗначениеПоУмолчанию,
		КодПреобразования);

КонецФункции

Функция Преобразовать(Источник, Правила, Преобразователь = Неопределено) Экспорт

	Если ТипЗнч(Источник) <> Тип("Структура") Тогда
		ВызватьИсключение "Источник DTO должен иметь тип Структура.";
	КонецЕсли;

	Результат = Новый Структура;
	Для Каждого Правило Из Правила Цикл
		ПроверитьПравило(Правило, Результат);
		ЗначениеПоля = Неопределено;
		ПолеНайдено = Источник.Свойство(Правило.ИмяПоляИсточника, ЗначениеПоля);
		Если Не ПолеНайдено Или ЗначениеПоля = Неопределено Тогда
			ЗначениеПоля = Правило.ЗначениеПоУмолчанию;
		КонецЕсли;
		Если Правило.Обязательное И Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
			ВызватьИсключение "Не заполнено обязательное поле " + Правило.ИмяПоляИсточника + ".";
		КонецЕсли;

		Если Не ПустаяСтрока(Правило.КодПреобразования) Тогда
			Если Преобразователь = Неопределено Тогда
				ВызватьИсключение "Для правила требуется преобразователь значений.";
			КонецЕсли;
			ЗначениеПоля = Преобразователь.Преобразовать(Правило.КодПреобразования, ЗначениеПоля);
		КонецЕсли;
		Результат.Вставить(Правило.ИмяПоляПриемника, ЗначениеПоля);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПроверитьПравило(Правило, Результат)

	Если ТипЗнч(Правило) <> Тип("Структура") Тогда
		ВызватьИсключение "Правило DTO должно иметь тип Структура.";
	КонецЕсли;
	ОбязательныеПоля = СтрРазделить(
		"ИмяПоляИсточника,ИмяПоляПриемника,Обязательное,ЗначениеПоУмолчанию,КодПреобразования",
		",");
	Для Каждого ИмяПоля Из ОбязательныеПоля Цикл
		Если Не Правило.Свойство(ИмяПоля) Тогда
			ВызватьИсключение "В правиле DTO отсутствует поле " + ИмяПоля + ".";
		КонецЕсли;
	КонецЦикла;
	Если Результат.Свойство(Правило.ИмяПоляПриемника) Тогда
		ВызватьИсключение "Поле приемника описано более одного раза: " + Правило.ИмяПоляПриемника + ".";
	КонецЕсли;

КонецПроцедуры
