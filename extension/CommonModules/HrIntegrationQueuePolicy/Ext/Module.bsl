// Чистая политика очереди. Не обращается к хранилищу и не зависит от прикладных объектов.

Функция НоваяПолитика(ДлительностьАрендыСекунд = 300, МаксимумПопыток = 5, БазоваяЗадержкаСекунд = 120,
	МаксимальнаяЗадержкаСекунд = 3600) Экспорт

	Если ДлительностьАрендыСекунд <= 0 Тогда
		ВызватьИсключение "Длительность аренды должна быть положительной.";
	КонецЕсли;
	Если МаксимумПопыток <= 0 Тогда
		ВызватьИсключение "Максимум попыток должен быть положительным.";
	КонецЕсли;
	Если БазоваяЗадержкаСекунд <= 0 Или МаксимальнаяЗадержкаСекунд < БазоваяЗадержкаСекунд Тогда
		ВызватьИсключение "Параметры задержки заданы неверно.";
	КонецЕсли;

	Возврат Новый Структура(
		"ДлительностьАрендыСекунд,МаксимумПопыток,БазоваяЗадержкаСекунд,МаксимальнаяЗадержкаСекунд",
		ДлительностьАрендыСекунд,
		МаксимумПопыток,
		БазоваяЗадержкаСекунд,
		МаксимальнаяЗадержкаСекунд);

КонецФункции

Функция МожноЗахватить(Задание, Момент) Экспорт

	ПроверитьКонтрактЗадания(Задание);

	Если Задание.Состояние = "Новое" Тогда
		Возврат Истина;
	ИначеЕсли Задание.Состояние = "ОжидаетПовтора" Тогда
		Возврат Задание.СледующаяПопытка <= Момент;
	ИначеЕсли Задание.Состояние = "ВОбработке" Тогда
		Возврат Задание.АрендаДо <= Момент;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПодготовитьЗахват(Задание, КлючИсполнителя, Момент, Политика) Экспорт

	Если ПустаяСтрока(КлючИсполнителя) Тогда
		ВызватьИсключение "Не указан ключ исполнителя.";
	КонецЕсли;
	Если Не МожноЗахватить(Задание, Момент) Тогда
		ВызватьИсключение "Задание недоступно для захвата.";
	КонецЕсли;

	Результат = КопияЗадания(Задание);
	Результат.Состояние = "ВОбработке";
	Результат.Попытки = Задание.Попытки + 1;
	Результат.Версия = Задание.Версия + 1;
	Результат.СледующаяПопытка = Неопределено;
	Результат.ВладелецАренды = КлючИсполнителя;
	Результат.АрендаДо = Момент + Политика.ДлительностьАрендыСекунд;
	Возврат Результат;

КонецФункции

Функция ПодготовитьЗавершение(Задание, КлючИсполнителя, Момент) Экспорт

	ПроверитьВладениеАрендой(Задание, КлючИсполнителя, Момент);
	Результат = КопияЗадания(Задание);
	Результат.Состояние = "Завершено";
	Результат.Версия = Задание.Версия + 1;
	ОчиститьАренду(Результат);
	Возврат Результат;

КонецФункции

Функция ПодготовитьОшибку(Задание, КлючИсполнителя, Момент, ТипОшибки, КодОшибки, Политика) Экспорт

	ПроверитьВладениеАрендой(Задание, КлючИсполнителя, Момент);
	Если ТипОшибки <> "Временная" И ТипОшибки <> "Постоянная" Тогда
		ВызватьИсключение "Тип ошибки должен быть Временная или Постоянная.";
	КонецЕсли;

	Результат = КопияЗадания(Задание);
	Результат.Версия = Задание.Версия + 1;
	Результат.КодПоследнейОшибки = КодОшибки;
	ОчиститьАренду(Результат);

	Если ТипОшибки = "Постоянная" Или Результат.Попытки >= Политика.МаксимумПопыток Тогда
		Результат.Состояние = "ОтложеноНавсегда";
		Результат.СледующаяПопытка = Неопределено;
	Иначе
		Результат.Состояние = "ОжидаетПовтора";
		Результат.СледующаяПопытка = Момент + ЗадержкаПередПовтором(Результат.Попытки, Политика);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЗадержкаПередПовтором(НомерПопытки, Политика) Экспорт

	Задержка = Политика.БазоваяЗадержкаСекунд;
	Для Счетчик = 2 По НомерПопытки Цикл
		Задержка = Мин(Задержка * 2, Политика.МаксимальнаяЗадержкаСекунд);
	КонецЦикла;
	Возврат Задержка;

КонецФункции

Процедура ПроверитьКонтрактЗадания(Задание)

	Если ТипЗнч(Задание) <> Тип("Структура") Тогда
		ВызватьИсключение "Задание должно иметь тип Структура.";
	КонецЕсли;
	Для Каждого ИмяПоля Из ОбязательныеПоляЗадания() Цикл
		Если Не Задание.Свойство(ИмяПоля) Тогда
			ВызватьИсключение "В задании отсутствует поле " + ИмяПоля + ".";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОбязательныеПоляЗадания()

	Возврат СтрРазделить(
		"Идентификатор,КлючИдемпотентности,Состояние,Версия,Попытки,СледующаяПопытка,АрендаДо,"
		+ "ВладелецАренды,КодПоследнейОшибки,ПолезнаяНагрузка",
		",");

КонецФункции

Процедура ПроверитьВладениеАрендой(Задание, КлючИсполнителя, Момент)

	ПроверитьКонтрактЗадания(Задание);
	Если Задание.Состояние <> "ВОбработке" Тогда
		ВызватьИсключение "Задание не находится в обработке.";
	КонецЕсли;
	Если Задание.ВладелецАренды <> КлючИсполнителя Тогда
		ВызватьИсключение "Аренда принадлежит другому исполнителю.";
	КонецЕсли;
	Если Задание.АрендаДо < Момент Тогда
		ВызватьИсключение "Срок аренды задания истек.";
	КонецЕсли;

КонецПроцедуры

Функция КопияЗадания(Задание)

	Возврат Новый Структура(
		"Идентификатор,КлючИдемпотентности,Состояние,Версия,Попытки,СледующаяПопытка,АрендаДо,"
		+ "ВладелецАренды,КодПоследнейОшибки,ПолезнаяНагрузка",
		Задание.Идентификатор,
		Задание.КлючИдемпотентности,
		Задание.Состояние,
		Задание.Версия,
		Задание.Попытки,
		Задание.СледующаяПопытка,
		Задание.АрендаДо,
		Задание.ВладелецАренды,
		Задание.КодПоследнейОшибки,
		Задание.ПолезнаяНагрузка);

КонецФункции

Процедура ОчиститьАренду(Задание)
	Задание.ВладелецАренды = "";
	Задание.АрендаДо = Неопределено;
КонецПроцедуры
