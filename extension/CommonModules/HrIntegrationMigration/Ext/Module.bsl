// Хранилище — адаптер карты идентификаторов с методами НайтиПоСтарому(), НайтиПоНовому() и Записать().

Функция ПеренестиИдентификатор(Хранилище, ТипСущности, ЛокальныйКлюч, СтарыйИД, НовыйИД) Экспорт

	Если ПустаяСтрока(СтарыйИД) Или ПустаяСтрока(НовыйИД) Тогда
		ВызватьИсключение "Для миграции требуются оба идентификатора.";
	КонецЕсли;

	ЗаписьПоСтарому = Хранилище.НайтиПоСтарому(ТипСущности, СтарыйИД);
	ЗаписьПоНовому = Хранилище.НайтиПоНовому(ТипСущности, НовыйИД);

	Если ЗаписьПоНовому <> Неопределено И ЗаписьПоНовому.ЛокальныйКлюч <> ЛокальныйКлюч Тогда
		ВызватьИсключение "Новый идентификатор уже связан с другим объектом.";
	КонецЕсли;

	Если ЗаписьПоСтарому <> Неопределено И ЗаписьПоСтарому.ЛокальныйКлюч <> ЛокальныйКлюч Тогда
		ВызватьИсключение "Старый идентификатор связан с другим объектом.";
	КонецЕсли;

	Хранилище.Записать(ТипСущности, ЛокальныйКлюч, СтарыйИД, НовыйИД, "Перенесен");
	Возврат НовыйИД;

КонецФункции
