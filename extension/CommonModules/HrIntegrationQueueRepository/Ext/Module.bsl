// Репозиторий передается как атомарный адаптер хранилища.
// Требуемые методы: ДобавитьЕслиОтсутствует(), ПолучитьКандидатов(), Получить() и ОбновитьЕслиВерсия().

Функция НовоеЗадание(Идентификатор, КлючИдемпотентности, ПолезнаяНагрузка) Экспорт

	Если ПустаяСтрока(Идентификатор) Или ПустаяСтрока(КлючИдемпотентности) Тогда
		ВызватьИсключение "Идентификатор и ключ идемпотентности обязательны.";
	КонецЕсли;

	Возврат Новый Структура(
		"Идентификатор,КлючИдемпотентности,Состояние,Версия,Попытки,СледующаяПопытка,АрендаДо,"
		+ "ВладелецАренды,КодПоследнейОшибки,ПолезнаяНагрузка",
		Идентификатор,
		КлючИдемпотентности,
		"Новое",
		0,
		0,
		Дата(1, 1, 1),
		Дата(1, 1, 1),
		"",
		"",
		ПолезнаяНагрузка);

КонецФункции

Функция ДобавитьЕслиОтсутствует(Репозиторий, Задание) Экспорт

	// Уникальность ключа идемпотентности должна обеспечиваться самим хранилищем.
	Возврат Репозиторий.ДобавитьЕслиОтсутствует(Задание.КлючИдемпотентности, Задание);

КонецФункции

Функция ЗахватитьСледующее(Репозиторий, КлючИсполнителя, Момент, Политика, РазмерВыборки = 20) Экспорт

	Если РазмерВыборки <= 0 Тогда
		ВызватьИсключение "Размер выборки должен быть положительным.";
	КонецЕсли;

	Кандидаты = Репозиторий.ПолучитьКандидатов(Момент, РазмерВыборки);
	Для Каждого Идентификатор Из Кандидаты Цикл
		Задание = Репозиторий.Получить(Идентификатор);
		Если Задание = Неопределено Или Не HrIntegrationQueuePolicy.МожноЗахватить(Задание, Момент) Тогда
			Продолжить;
		КонецЕсли;

		ЗахваченноеЗадание = HrIntegrationQueuePolicy.ПодготовитьЗахват(
			Задание,
			КлючИсполнителя,
			Момент,
			Политика);
		Если Репозиторий.ОбновитьЕслиВерсия(Идентификатор, Задание.Версия, ЗахваченноеЗадание) Тогда
			Возврат ЗахваченноеЗадание;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция Завершить(Репозиторий, Идентификатор, КлючИсполнителя, Момент) Экспорт

	Задание = ПолучитьОбязательноеЗадание(Репозиторий, Идентификатор);
	Результат = HrIntegrationQueuePolicy.ПодготовитьЗавершение(Задание, КлючИсполнителя, Момент);
	ПроверитьКонкурентноеОбновление(Репозиторий, Задание, Результат);
	Возврат Результат;

КонецФункции

Функция ЗафиксироватьОшибку(
	Репозиторий,
	Идентификатор,
	КлючИсполнителя,
	Момент,
	ТипОшибки,
	КодОшибки,
	Политика) Экспорт

	Задание = ПолучитьОбязательноеЗадание(Репозиторий, Идентификатор);
	Результат = HrIntegrationQueuePolicy.ПодготовитьОшибку(
		Задание,
		КлючИсполнителя,
		Момент,
		ТипОшибки,
		КодОшибки,
		Политика);
	ПроверитьКонкурентноеОбновление(Репозиторий, Задание, Результат);
	Возврат Результат;

КонецФункции

Функция ПолучитьОбязательноеЗадание(Репозиторий, Идентификатор)

	Задание = Репозиторий.Получить(Идентификатор);
	Если Задание = Неопределено Тогда
		ВызватьИсключение "Задание не найдено.";
	КонецЕсли;
	Возврат Задание;

КонецФункции

Процедура ПроверитьКонкурентноеОбновление(Репозиторий, ИсходноеЗадание, НовоеЗадание)

	Если Не Репозиторий.ОбновитьЕслиВерсия(
		ИсходноеЗадание.Идентификатор,
		ИсходноеЗадание.Версия,
		НовоеЗадание) Тогда
		ВызватьИсключение "Задание уже изменено другим исполнителем.";
	КонецЕсли;

КонецПроцедуры
