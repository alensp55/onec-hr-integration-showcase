// Демонстрационный модуль. Не зависит от контракта реального API.

Функция СформироватьКлючИдемпотентности(ТипОбъекта, ИдентификаторИсточника, Ревизия) Экспорт

	КаноническаяСтрока = НРег(СокрЛП(ТипОбъекта)) + "|" + СокрЛП(ИдентификаторИсточника)
		+ "|" + Формат(Ревизия, "ЧГ=0");
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(КаноническаяСтрока, КодировкаТекста.UTF8);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДвоичныеДанные);

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

Функция СледующееСостояние(ТекущееСостояние, Событие) Экспорт

	Если ТекущееСостояние = "Новое" И Событие = "Захват" Тогда
		Возврат "ВОбработке";
	ИначеЕсли ТекущееСостояние = "ВОбработке" И Событие = "Успех" Тогда
		Возврат "Завершено";
	ИначеЕсли ТекущееСостояние = "ВОбработке" И Событие = "ВременнаяОшибка" Тогда
		Возврат "ОжидаетПовтора";
	ИначеЕсли ТекущееСостояние = "ВОбработке" И Событие = "ПостояннаяОшибка" Тогда
		Возврат "Ошибка";
	ИначеЕсли ТекущееСостояние = "ОжидаетПовтора" И Событие = "Захват" Тогда
		Возврат "ВОбработке";
	КонецЕсли;

	ВызватьИсключение "Недопустимый переход состояния: " + ТекущееСостояние + " / " + Событие;

КонецФункции

Функция КлассифицироватьHTTPКод(КодСостояния) Экспорт

	Если КодСостояния >= 200 И КодСостояния < 300 Тогда
		Возврат "Успех";
	ИначеЕсли КодСостояния = 408 Или КодСостояния = 429 Или КодСостояния >= 500 Тогда
		Возврат "ВременнаяОшибка";
	Иначе
		Возврат "ПостояннаяОшибка";
	КонецЕсли;

КонецФункции

Функция СледующаяПопытка(ТекущаяДата, НомерПопытки) Экспорт

	Если НомерПопытки <= 1 Тогда
		ЗадержкаМинуты = 2;
	ИначеЕсли НомерПопытки = 2 Тогда
		ЗадержкаМинуты = 4;
	ИначеЕсли НомерПопытки = 3 Тогда
		ЗадержкаМинуты = 8;
	ИначеЕсли НомерПопытки = 4 Тогда
		ЗадержкаМинуты = 16;
	ИначеЕсли НомерПопытки = 5 Тогда
		ЗадержкаМинуты = 32;
	Иначе
		ЗадержкаМинуты = 60;
	КонецЕсли;
	Возврат ТекущаяДата + ЗадержкаМинуты * 60;

КонецФункции

Функция ИсчерпанЛимитПопыток(НомерПопытки) Экспорт

	Возврат НомерПопытки >= 5;

КонецФункции
