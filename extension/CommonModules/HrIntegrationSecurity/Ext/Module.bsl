Функция БезопасноеЗначениеДляЖурнала(ИмяПоля, Значение) Экспорт

	Если ПолеСодержитЗакрытыеДанные(ИмяПоля) Тогда
		Возврат "<redacted>";
	КонецЕсли;

	Если НЕ ПустаяСтрока(ИмяПоля) И НЕ ПолеРазрешеноВЖурнале(ИмяПоля) Тогда
		Возврат "<omitted>";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		Возврат "<binary>";
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Элемент.Ключ, БезопасноеЗначениеДляЖурнала(Элемент.Ключ, Элемент.Значение));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат "<list>";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат БезопасныйМашинныйКод(Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция БезопасныйМашинныйКод(Значение)

	Результат = НРег(СокрЛП(Значение));
	Если ПустаяСтрока(Результат) Или СтрДлина(Результат) > 64 Тогда
		Возврат "<omitted>";
	КонецЕсли;

	ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyz_:-" + "01234" + "56789";
	Для НомерСимвола = 1 По СтрДлина(Результат) Цикл
		Если СтрНайти(ДопустимыеСимволы, Сред(Результат, НомерСимвола, 1)) = 0 Тогда
			Возврат "<omitted>";
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолеРазрешеноВЖурнале(ИмяПоля)

	ИмяПоля = НРег(ИмяПоля);
	Возврат ИмяПоля = "error"
		Или ИмяПоля = "result"
		Или ИмяПоля = "state"
		Или ИмяПоля = "status"
		Или ИмяПоля = "duration"
		Или ИмяПоля = "size";

КонецФункции

Функция ПолеСодержитЗакрытыеДанные(ИмяПоля)

	ИмяПоля = НРег(ИмяПоля);
	ЗакрытыеФрагменты = Новый Массив;
	ЗакрытыеФрагменты.Добавить("authorization");
	ЗакрытыеФрагменты.Добавить("password");
	ЗакрытыеФрагменты.Добавить("secret");
	ЗакрытыеФрагменты.Добавить("token");
	ЗакрытыеФрагменты.Добавить("инн");
	ЗакрытыеФрагменты.Добавить("снилс");
	ЗакрытыеФрагменты.Добавить("паспорт");

	Для Каждого Фрагмент Из ЗакрытыеФрагменты Цикл
		Если СтрНайти(ИмяПоля, Фрагмент) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции
