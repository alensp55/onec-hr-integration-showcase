// Нейтральный компонент вложений. Репозиторий отвечает за атомарную уникальность контрольной суммы.

Функция ПодготовитьВложение(ИмяФайла, ТипСодержимого, Данные, МаксимальныйРазмерБайт, РазрешенныеТипы) Экспорт

	ПроверитьИмяФайла(ИмяФайла);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Содержимое вложения должно иметь тип ДвоичныеДанные.";
	КонецЕсли;
	Если Данные.Размер() = 0 Или Данные.Размер() > МаксимальныйРазмерБайт Тогда
		ВызватьИсключение "Размер вложения выходит за допустимые границы.";
	КонецЕсли;
	Если РазрешенныеТипы.Найти(НРег(ТипСодержимого)) = Неопределено Тогда
		ВызватьИсключение "Тип содержимого вложения не разрешен.";
	КонецЕсли;

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	КонтрольнаяСумма = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
	Возврат Новый Структура(
		"ИмяФайла,ТипСодержимого,Размер,КонтрольнаяСумма,Данные",
		ИмяФайла,
		НРег(ТипСодержимого),
		Данные.Размер(),
		КонтрольнаяСумма,
		Данные);

КонецФункции

Функция СохранитьЕслиОтсутствует(Репозиторий, Вложение) Экспорт

	Существующее = Репозиторий.НайтиПоКонтрольнойСумме(Вложение.КонтрольнаяСумма);
	Если Существующее <> Неопределено Тогда
		Возврат Новый Структура("Создано,Идентификатор", Ложь, Существующее.Идентификатор);
	КонецЕсли;

	// Метод должен повторно проверить уникальность в той же транзакции, чтобы закрыть гонку между исполнителями.
	Возврат Репозиторий.СохранитьЕслиОтсутствует(Вложение.КонтрольнаяСумма, Вложение);

КонецФункции

Процедура ПроверитьИмяФайла(ИмяФайла)

	Если ПустаяСтрока(ИмяФайла) Тогда
		ВызватьИсключение "Имя вложения не может быть пустым.";
	КонецЕсли;
	Если СтрНайти(ИмяФайла, "/") > 0 Или СтрНайти(ИмяФайла, "\") > 0 Или СтрНайти(ИмяФайла, ":") > 0 Тогда
		ВызватьИсключение "Имя вложения не должно содержать путь.";
	КонецЕсли;

КонецПроцедуры
