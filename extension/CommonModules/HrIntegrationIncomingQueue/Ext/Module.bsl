// Очередь — адаптер атомарного хранилища входящих заданий.

Функция ОбработатьЗадание(Очередь, Обработчик, ИдентификаторЗадания) Экспорт

	Задание = Очередь.Захватить(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Результат = Обработчик.Выполнить(Задание);
		Очередь.Завершить(ИдентификаторЗадания, Результат.ИдентификаторДокумента);
		Возврат Истина;
	Исключение
		ОписаниеИсключения = ИнформацияОбОшибке();
		Если Обработчик.КлассифицироватьОшибку(ОписаниеИсключения) = "Временная" Тогда
			Очередь.ЗапланироватьПовтор(ИдентификаторЗадания, "temporary_error");
		Иначе
			Очередь.ЗавершитьСОшибкой(ИдентификаторЗадания, "permanent_error");
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;

КонецФункции
